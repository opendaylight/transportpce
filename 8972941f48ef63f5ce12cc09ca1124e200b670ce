    {
      "unresolved": true,
      "key": {
        "uuid": "d64d7fe1_4aca6042",
        "filename": "api/src/main/yang/service_path/transportpce-tapi-sbi@2026-04-10.yang",
        "patchSetId": 13
      },
      "lineNbr": 1,
      "author": {
        "id": 7217
      },
      "writtenOn": "2026-07-16T09:14:41Z",
      "side": 1,
      "message": "This was added in the service path to follow the same approach that we applied until now. This file include the definition of several new rpcs/notifications specific to tapi. Their equivalent were already defined in yang files of service-path. Taking the example of service-implementation-request, all is defined in service-path. Thus, it makes sense to define tapi-service-implementation-request in the same place. Does it make sense to you?",
      "parentUuid": "539eddf7_3d6fa6a7",
      "revId": "8972941f48ef63f5ce12cc09ca1124e200b670ce",
      "serverId": "7fc14799-209e-464c-9743-7a06c2c21a81"
    },
